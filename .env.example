# ===========================================
# Juegos Evita — secretos para docker-compose.yml (uso local)
# ===========================================
# Copiar a `.env` en esta misma carpeta y completar. `.env` no se commitea.
# Más fácil: `cd backend && npm run setup` lo crea solo con secretos al azar
# (si `.env` ya existe no lo toca), levanta el stack y carga los datos de prueba.
# El backend NO arranca con valores por defecto (admin123, minioadmin, etc.).
# Generar cada valor con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

DB_PASSWORD=<GENERAR>
JWT_ACCESS_SECRET=<GENERAR-64>
JWT_REFRESH_SECRET=<GENERAR-64>
MINIO_ACCESS_KEY=<GENERAR>
MINIO_SECRET_KEY=<GENERAR>

# Usuario administrador que crea el seed
SEED_ADMIN_EMAIL=admin@juegosevita.gob.ar
SEED_ADMIN_PASSWORD=<GENERAR>

# La seed corre sola sólo en el primer arranque (base vacía). `false` lo desactiva.
# Para recargar los datos de prueba (desde backend/): npm run db:demo
# Para vaciar la base y recargarla desde cero:        npm run db:demo:reset
SEED_ON_START=true
