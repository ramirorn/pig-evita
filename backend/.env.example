# ============================================
# Plataforma Juegos Evita - Environment Config
# ============================================
# Copy this file to .env and fill in the values.

# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME="Juegos Evita Formosa"

# Database (PostgreSQL)
# Host-side Docker port mapping for development: 5434 -> container 5432
DATABASE_URL=postgresql://evita_user:evita_password@localhost:5434/juegos_evita?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_REFRESH_EXPIRATION=7d

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
# Credenciales propias, nunca los defaults de MinIO. El backend NO arranca si
# detecta "minioadmin" (o cualquier otro default) ni si tienen menos de 8 chars.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MINIO_ACCESS_KEY=<GENERAR-CREDENCIAL-PROPIA>
MINIO_SECRET_KEY=<GENERAR-CON-crypto-randomBytes-32>
MINIO_BUCKET=juegos-evita
MINIO_USE_SSL=false

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Cors
CORS_ORIGINS=http://localhost:5173

# Super Admin Seed
SEED_ADMIN_EMAIL=admin@juegovita.gob.ar
SEED_ADMIN_PASSWORD=Admin123!@#
