# ============================================
# Plataforma Juegos Evita - Environment Config
# ============================================
# Copy this file to .env and fill in the values.

# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME="Juegos Evita Formosa"

# Database (PostgreSQL)
# Host-side Docker port mapping for development: 5434 -> container 5432
# En produccion la contrasena tambien se valida contra la lista de defaults.
DATABASE_URL=postgresql://evita_user:evita_password@localhost:5434/juegos_evita?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
# El backend NO arranca si detecta un valor por defecto (change-me, password,
# secret, admin123, minioadmin, default, qwerty, 123456...) ni si tiene menos de
# 32 caracteres. Generar cada uno con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_ACCESS_SECRET=<GENERAR-CON-crypto-randomBytes-64>
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=<GENERAR-CON-crypto-randomBytes-64>
JWT_REFRESH_EXPIRATION=7d

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
# Credenciales propias, nunca los defaults de MinIO. El backend NO arranca si
# detecta "minioadmin" (o cualquier otro default) ni si tienen menos de 8 chars.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MINIO_ACCESS_KEY=<GENERAR-CREDENCIAL-PROPIA>
MINIO_SECRET_KEY=<GENERAR-CON-crypto-randomBytes-32>
MINIO_BUCKET=juegos-evita
MINIO_USE_SSL=false

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Cors
CORS_ORIGINS=http://localhost:5173

# Super Admin Seed
# Mínimo 12 caracteres y sin patrones por defecto. Generar con:
#   node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
SEED_ADMIN_EMAIL=admin@juegovita.gob.ar
SEED_ADMIN_PASSWORD=<GENERAR-CON-crypto-randomBytes-12>

# ===========================================
# Sync de noticias del portal oficial (S19)
# ===========================================
# El backend trae al listado propio las noticias de Juegos Evita publicadas en
# formosa.gob.ar, ENLAZANDO al original (no copia el cuerpo del articulo).
#
# Viene apagado: el timer diario sale a Internet contra un sitio ajeno y eso se
# enciende a conciencia. Con esto en `false`, el boton de sincronizacion manual
# del panel (accion NEWS_SYNC) sigue funcionando.
NEWS_SYNC_ENABLED=false
# Hora local del server para la corrida diaria (0-23).
NEWS_SYNC_HORA=6
# Tope de IDs que recorre por corrida y pausa entre requests: ser un invitado
# educado en un sitio que no es nuestro.
NEWS_SYNC_MAX_IDS=60
NEWS_SYNC_DELAY_MS=1000
NEWS_SYNC_TIMEOUT_MS=15000
# IDs inexistentes seguidos que alcanzan para dar por terminado el recorrido.
NEWS_SYNC_MAX_FALLOS=10
# Desde donde arranca la primera corrida. La 34709 ("Las chicas de Belgrano,
# campeonas") es la siguiente, y es el caso de prueba de la tarea.
NEWS_SYNC_START_ID=34708
# Nota de control: si deja de parsear o de clasificar como Juegos Evita, el
# portal cambio el markup y la corrida ABORTA en vez de informar cero noticias.
NEWS_SYNC_CANARY_ID=34709
# Dias sin una nota nueva antes de que la corrida termine en alerta.
NEWS_SYNC_MAX_DIAS_SIN_NOTAS=30
